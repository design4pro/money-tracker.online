{
  "name": "money-tracker-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "tsr generate && tsc --noEmit && eslint src tests scripts vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:staging": "node scripts/cloud.mjs migrate staging",
    "migrate:production": "node scripts/cloud.mjs migrate production",
    "deploy:staging": "node scripts/cloud.mjs deploy staging",
    "deploy:production": "node scripts/cloud.mjs deploy production",
    "test:chat-proof": "tsx --test tests/chat-worker.proof.ts",
    "test:chat-browser": "CHAT_BROWSER=1 npm run test:chat-proof"
  },
  "dependencies": {
    "@agent-native/agentkit": "0.231.0",
    "@agent-native/core": "0.231.0",
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@polar-sh/sdk": "1.3.3",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "better-auth": "1.7.28",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.81.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.3",
    "shadcn": "4.23.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.2",
    "@cloudflare/workers-types": "5.20261125.1",
    "@tanstack/eslint-config": "0.5.0",
    "@tanstack/router-cli": "1.168.0",
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "miniflare": "5.20261123.1-beta",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.4.0",
    "wrangler": "4.168.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
