{
  // Line comments, not block ones: a `**` glob written inside a block comment closes it early
  // on its own `*` `/`.
  "include": ["**/*.ts", "**/*.tsx", "prettier.config.js"],

  // Spelled out because naming an `exclude` replaces the default one, which is where
  // `node_modules` comes from.
  "exclude": ["node_modules", "dist"],

  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"]
    },
    /* `ES2023.Intl` is type-only: it declares the string form of `useGrouping`, which the
       per-locale money formatters in `src/lib` freeze.
       `ES2023.Array` is for `toSorted`, which the money allocator, the currency picker and the
       i18n parity gate all use. It is a copying sort: sorting a frozen catalogue in place is a
       runtime throw, and sorting a caller's array in place is a bug in whatever handed it over.
       Both workerd and every browser this product supports ship it. */
    "lib": ["ES2022", "ES2023.Array", "ES2023.Intl", "DOM", "DOM.Iterable"],
    /* Workers runtime globals (D1Database, KVNamespace, R2Bucket, Queue, DurableObjectNamespace)
       so `worker-configuration.d.ts` can name them without importing. They collide with `DOM`
       on Response/Request/WebSocket and friends; `skipLibCheck` below is what makes the two
       coexist, exactly as it does in the generated-types setup this repo is ported from. */
    /* `@cloudflare/vitest-pool-workers/types` declares the `cloudflare:test` module, which only
       the `*.workerd.test.ts` files import. It is listed globally because a second tsconfig for a
       handful of test files would cost more than it explains. */
    "types": [
      "vite/client",
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types"
    ],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
