{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Project-scoped Claude Code settings for money-tracker.online. deny holds the few operations nothing recovers from - secrets, generated files, history rewrites, deleted Cloudflare stores - and wins over ask and allow in every mode. ask holds what a developer approves at the keyboard - deploys, remote D1, the hand-mirrored worker-configuration.d.ts; a cezar run uses --permission-mode dontAsk, so there it is refused (ADR 0025). The allow list carries only the tracker operations the om-* pipeline cannot run without. Every other permission rule stays per-developer in the gitignored .claude/settings.local.json.",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "permissions": {
    "allow": [
      "Bash(gh pr review:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh run view:*)",
      "Bash(gh issue:*)"
    ],
    "ask": [
      "Edit(/worker-configuration.d.ts)",
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler versions deploy*)",
      "Bash(*wrangler d1 * --remote*)"
    ],
    "deny": [
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(gh repo delete:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Read(.dev.vars*)",
      "Read(.env*)",
      "Read(!*.example)",
      "Read(.ai/qa/test-env.env)",
      "Edit(/src/routeTree.gen.ts)",
      "Edit(/drizzle/**)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard*)",
      "Bash(git *--no-verify*)",
      "Bash(*wrangler secret put*)",
      "Bash(*wrangler secret bulk*)",
      "Bash(*wrangler d1 delete*)",
      "Bash(*wrangler r2 bucket delete*)",
      "Bash(*wrangler kv namespace delete*)",
      "Bash(*wrangler delete*)"
    ]
  },
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "enabledMcpjsonServers": ["polar-sandbox"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\" ] || node \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\" ] || node \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
