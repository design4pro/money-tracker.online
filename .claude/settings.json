{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Project-scoped Claude Code settings for money-tracker.online. The guardrails that must apply to every checkout live in .claude/hooks, and the allow list carries only the tracker operations the om-* pipeline cannot run without. Every other permission rule stays per-developer in the gitignored .claude/settings.local.json.",
  "permissions": { "allow": ["Bash(gh pr review:*)", "Bash(gh pr comment:*)"] },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-generated.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-guardrails.sh"
          }
        ]
      },
      {
        "matcher": "Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-read.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh"
          }
        ]
      }
    ]
  }
}
