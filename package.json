{
  "name": "money-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging pnpm run deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:update": "playwright test --update-snapshots",
    "generate-routes": "tsr generate",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply money-tracker-db --local",
    "db:migrate:staging": "wrangler d1 migrations apply money-tracker-db-staging --remote --env staging",
    "db:migrate:prod": "wrangler d1 migrations apply money-tracker-db --remote",
    "sandcastle": "tsx .sandcastle/main.ts",
    "sandcastle:triage": "tsx .sandcastle/triage.ts",
    "sandcastle:report": "tsx .sandcastle/report.ts",
    "sandcastle:baselines": "tsx .sandcastle/record-baselines.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@internationalized/date": "^3.10.0",
    "@internationalized/number": "^3.6.8",
    "@react-email/components": "^1.0.12",
    "@sentry/cloudflare": "^10.72.0",
    "@sentry/react": "^10.72.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.10",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "^1.170.30",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.47",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.32.0",
    "motion": "^13.1.0",
    "nanoid": "^6.0.1",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-aria-components": "~1.20.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-react-aria-components": "^2.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/workers-types": "^5.20260818.1",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/d3-time": "^3.0.4",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.8.1",
    "react-email": "^6.9.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.70.0"
  }
}
