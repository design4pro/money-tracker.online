# money-tracker.online — build-time public values template
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
#
# Everything here is read by **Vite** from `import.meta.env` and inlined into both bundles at
# build time. Nothing here is a secret, and nothing here reaches the Worker's `env`.
#
# THE TRAP, stated in both files because it costs an afternoon in either direction:
#
#   • While a `.dev.vars` file exists, Cloudflare loads NO `.env` file into the Worker's `env`.
#     A runtime secret put in `.env.local` is therefore silently `undefined` at runtime — not an
#     error, just missing.
#   • A `VITE_*` name put in `.dev.vars` is silently empty at build time — again not an error,
#     just an empty string inlined into the bundle.
#
#   Runtime secret → `.dev.vars`.  Build-time public value → `.env.local`.  Never the other way.
#
# And the same gotcha as `.dev.vars.example`: **a commented-out line is not a key.** A name that
# exists only inside a `#` comment does not exist to any reader of this inventory.
#
# In CI these are repository *variables* (not secrets), passed into the build in ci.yml,
# deploy.yml and deploy-staging.yml. The three places move together, or a green build ships a
# pricing page with nothing on it.


# ── Polar product ids ────────────────────────────────────────────────────────
#
# One per purchasable product of the Polar organization. A product id ships in every client-side
# checkout integration, so these are public by construction.
#
# Sandbox and production are separate Polar accounts, so these are different values in the two
# places: `.env.local` carries the SANDBOX ids and CI carries the production ones. A sandbox id
# in a production build does not fail loudly — it opens a checkout for a product that account
# does not have.
#
# `src/lib/plans.ts` is the only reader. Leave one empty and `requirePrice()` throws for that
# plan and interval alone, so one Upgrade button fails while the others still open a checkout.
# The pricing page itself renders either way.
VITE_POLAR_PRODUCT_PLUS_MONTHLY=
VITE_POLAR_PRODUCT_PLUS_YEARLY=
VITE_POLAR_PRODUCT_HOUSEHOLD_MONTHLY=
VITE_POLAR_PRODUCT_HOUSEHOLD_YEARLY=


# ── Sentry, browser half ─────────────────────────────────────────────────────

# The same DSN as SENTRY_DSN in `.dev.vars`, and public by construction — it ships in the client
# bundle where anyone can read it.
VITE_SENTRY_DSN=

# Mirrors the ENVIRONMENT var the Worker reads from wrangler.jsonc. The browser cannot read a
# Worker var, so it is passed at build time. CI sets this per deploy: `staging` or `production`.
VITE_ENVIRONMENT=development

# The commit being deployed. Read by BOTH halves — Vite inlines it into the Worker bundle as well
# as the client one — so that one deploy is one release in Sentry instead of two that cannot be
# told apart. Leave it empty locally: a working copy is not a release.
VITE_SENTRY_RELEASE=
